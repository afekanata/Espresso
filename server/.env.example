# Local development config. Copy to `.env` (no secrets in SQLite dev mode).
# For production we'd inject DATABASE_URL via AWS Secrets Manager (see README).

# Prisma 7 + better-sqlite3 adapter: SQLite paths are resolved relative to the
# CWD where commands run, which for both the server (`pnpm dev`) and Prisma CLI
# (`pnpm exec prisma ...`) is the `server/` directory.
# `../db/data.sqlite` therefore resolves to /db/data.sqlite at the repo root.
DATABASE_URL="file:../db/data.sqlite"
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Lightweight auth stub (single hardcoded user). Replace AUTH_USERNAME /
# AUTH_PASSWORD and inject JWT_SECRET via Secrets Manager in prod.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
JWT_SECRET=dev-secret-do-not-use-in-prod
JWT_EXPIRES_IN=1h
