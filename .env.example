# Root-level .env for docker-compose substitution.
# Copy to `.env` on the host and fill in real values before `docker compose up`.
#
# `docker compose` reads ONLY this top-level .env — server/.env is irrelevant
# inside containers because we set DATABASE_URL etc. in docker-compose.yml.

AUTH_USERNAME=admin
AUTH_PASSWORD=changeme-before-deploy
JWT_SECRET=generate-a-real-secret-here-and-do-not-commit
JWT_EXPIRES_IN=12h
